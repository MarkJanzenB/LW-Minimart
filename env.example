# Copy this file to `.env.local` or `.env` and adjust the values as needed.
# Vite automatically loads any `.env*` file at the project root.

# URL of the Supabase project you want the app to talk to.
# For Supabase CLI local instances this is usually http://127.0.0.1:54321
# Replace with https://<project-ref>.supabase.co when using a hosted project.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# The Supabase anon (a.k.a. publishable) key.
# For Supabase CLI `supabase start`, copy the anon key from `supabase/.env`.
# When using a hosted project, grab the anon/public key from the Supabase dashboard.
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-or-remote-supabase-anon-key













